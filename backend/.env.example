# ============================================================
# Backend Environment Variables — pharma-blockchain-ai
# Copy this file to .env and fill in your values
# ============================================================

# ── Polygon / Ethereum ──────────────────────────────────────
# RPC URL for Polygon Amoy testnet
RPC_URL=https://rpc-amoy.polygon.technology

# Your wallet private key (KEEP THIS SECRET — never commit .env)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract address (from: npx hardhat run scripts/deploy.ts --network amoy)
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# ── Server ──────────────────────────────────────────────────
# Port the backend listens on
PORT=4000

# Public URL of the backend (used in QR code verify URLs)
BASE_URL=http://localhost:4000

# ── Authentication ──────────────────────────────────────────
# Secret key for signing JWTs — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-256-bit-secret-here

# ── Database ────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/pharmachain

# ── External Services ───────────────────────────────────────
# URL of the Python AI scoring engine
AI_ENGINE_URL=http://localhost:5000

# ── Hyperledger Fabric (optional) ───────────────────────────
# Leave blank if not using Hyperledger Fabric
# Path to Fabric connection profile JSON
FABRIC_CONNECTION_PROFILE=

# Path to Fabric wallet directory
FABRIC_WALLET_PATH=

# Fabric identity to use
FABRIC_IDENTITY=admin

# WebSocket port (defaults to same as PORT if not set)
WS_PORT=
